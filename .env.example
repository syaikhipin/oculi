# API security
OCULI_API_KEY=replace-with-32-byte-random-hex

# Storage and models
OCULI_DATA_DIR=data
OCULI_MODEL_DIR=models

# Face matching (SFace default; insightface is non-commercial)
OCULI_FACE_ENGINE=insightface
OCULI_MATCH_THRESHOLD=0.363
OCULI_ENROLL_REQUIRES_LIVENESS=1

# Redpanda
OCULI_REDPANDA_BROKERS=
OCULI_REDPANDA_TOPIC=oculi.events

# Operations
OCULI_EVENT_RETENTION_DAYS=30
OCULI_MAX_IMAGE_BYTES=15728640
OCULI_METRICS=1
OCULI_THUMBNAILS=1
OCULI_THUMBNAIL_MAX_PX=320

# Milestone Generic Events (optional)
OCULI_MILESTONE=0
OCULI_MILESTONE_PROTOCOL=tcp
OCULI_MILESTONE_HOST=
OCULI_MILESTONE_PORT=
OCULI_MILESTONE_WEBHOOK=
